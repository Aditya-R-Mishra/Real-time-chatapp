# ─── Server Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server port
PORT=5000

# MongoDB Atlas connection string
# Sign up free at https://mongodb.com/atlas
# 1. Create a free M0 cluster
# 2. Click "Connect" → "Connect your application"
# 3. Copy the connection string and replace <password> with your password
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chatapp?retryWrites=true&w=majority

# JWT secrets — generate random strings (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=your_access_secret_change_this_to_random_string
JWT_REFRESH_SECRET=your_refresh_secret_change_this_to_random_string

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (for file uploads) — sign up free at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
